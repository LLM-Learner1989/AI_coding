# ============================================================
#  AI Coding 智能体 — 环境变量模板
#
#  用法：复制本文件为 .env 并填入真实值
#      cp .env.example .env
#
#  注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
# ============================================================

# ---- 模型接入（必填）----
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek 服务地址（OpenAI 兼容协议）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 主 Agent 模型
MAIN_MODEL=deepseek-v4-pro

# ---- 意图分类模型（可选，默认回落到 MAIN_MODEL）----
INTENT_MODEL=
INTENT_MODEL_TEMPERATURE=0
INTENT_MODEL_MAX_TOKENS=200

# ---- GitHub（GITHUB_TOKEN 必填）----
# GitHub Personal Access Token（经 GIT_ASKPASS 注入，绝不写入日志/命令/提交）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE_URL=https://api.github.com
# 默认分支（项目默认 master；若仓库实际默认分支不是 master，请改这里）
GITHUB_DEFAULT_BRANCH=master
# 默认目标仓库
DEFAULT_REPO_URL=https://github.com/LLM-Learner1989/AI_coding

# ---- 工作区 / 本地沙箱 ----
# 工作区根目录（Agent 操作真实仓库的目录）
AI_WORKSPACE_ROOT=~/ai_workspace
# 本地 Shell 工作区（优先级高于 AI_WORKSPACE_ROOT，默认留空）
LOCAL_SHELL_WORKSPACE=
LOCAL_SHELL_PROJECTS_DIR=projects
LOCAL_SHELL_SHARED_PYTHON_VENV=runtimes/python/default/.venv
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
LOCAL_SHELL_CREATE_PYTHON_VENV=false

# ---- SQLite 数据目录 ----
# 业务摘要库 store.sqlite / checkpoint 库 checkpoints.sqlite / 长期记忆库 langgraph_store.sqlite
AICODING_DATA_DIR=./data
CHECKPOINT_DB_PATH=
STORE_DB_PATH=
LANGGRAPH_STORE_DB_PATH=

# ---- 日志 ----
AICODING_LOG_DIR=./logs
AICODING_LOG_LEVEL=INFO
AICODING_LOG_WHEN=midnight
AICODING_LOG_INTERVAL=1
AICODING_LOG_RETENTION_DAYS=14

# ---- Agent 运行保护上限（可选，按任务类型有各自默认值）----
AGENT_MAX_TOOL_CALLS=
AGENT_MAX_SECONDS=

# ---- LangSmith 追踪（可选）----
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
